#!/bin/bash

# chezmoi:shell

{{ if not (lookPath "mise") -}}
{{   if not (lookPath (joinPath .chezmoi.homeDir ".local/bin/mise")) -}}
echo "Installing mise..."
curl https://mise.run | sh
{{   end -}}
{{ end -}}

MISE_BIN="{{ if $m := lookPath "mise" -}}{{- $m -}}{{- else if $l := lookPath (joinPath .chezmoi.homeDir ".local/bin/mise") -}}{{- $l -}}{{- else -}}mise{{- end -}}"

"$MISE_BIN" trust "{{ .chezmoi.homeDir }}/.config/mise"
"$MISE_BIN" install
