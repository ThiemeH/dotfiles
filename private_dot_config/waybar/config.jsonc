
{
    "modules-left": [
        "custom/power"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/tray-drawer",
        // "bluetooth",
        "pulseaudio",
        "battery"
    ],
    // "bluetooth": {
    //     "format": "{icon}",
    //     "format-disabled": "󰂲",
    //     "format-on": "󰂯",
    //     "format-connected": "󰂱",
    //     "tooltip": true,
    //     "on-click": "blueman-manager & sleep 1 && pkill blueman-tray"
    // },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-plugged": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-alt": "{icon} {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip-format": "{time}",
        "interval": 30,
        "cursor": false
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "%",
        "format-bluetooth": "󰂯%",
        "format-bluetooth-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": [
                ""
            ]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "group/tray-drawer": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "click-to-reveal": true,
            "transition-left-to-right": false
        },
        "modules": ["custom/tray-toggle", "tray"]
    },
    "custom/tray-toggle": {
        "format": "󱊖",
        "tooltip": false
    },
    "tray": {
        "icon-size": 15.9,
        "spacing": 6,
        "cursor": true
    },
    "custom/power": {
        "format": "󰣇 ",
        "tooltip": false,
        "on-click": "niri msg action quit"
    },
    "clock": {
        "format": "{:%a %d/%m/%Y ~ %H:%M}",
        "tooltip-format": "<span size='11000' font-family='Awaita Mono' line_height='1'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#777777'>{}</span>",
                "weekdays": "<span color='#999999'>{}</span>",
                "days": "<span color='#555555'>{}</span>",
                "today": "<span color='#FFFFFF'>{}</span>"
            }
        },
        "on-click": "swaylock"
    }
}
